# Core app
APP_NAME=SaaS Boilerplate
APP_VERSION=0.2.0
DEBUG=True
SECRET_KEY=change-me-in-production-please-rotate

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/saasdb

# Auth / JWT
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis / async workers
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Stripe billing
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
STRIPE_PRO_PRICE_ID=price_pro_monthly
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise_monthly

# Email
EMAIL_FROM=noreply@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=True
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password

# Frontend / CORS
FRONTEND_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=["http://localhost:3000"]

# Object storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=
S3_ENDPOINT_URL=
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_TYPES=["image/png","image/jpeg","application/pdf","text/csv"]

# Rate limits
API_RATE_LIMIT_FREE=60
API_RATE_LIMIT_PRO=500
API_RATE_LIMIT_ENTERPRISE=5000

# Security / integrations
TOTP_ISSUER=SaaS Boilerplate
WEBHOOK_SIGNING_SECRET=local-webhook-secret
